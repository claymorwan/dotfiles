# need to rename current default.nix to unwrapped.nix aswell as in wayland-lib.nix
# tho i prolly don't need this bs lmfaooo

{
  lib,
  buildFHSEnv,
  callPackage,
}:

let
  unwrapped = callPackage ./unwrapped.nix { };
in
buildFHSEnv {
  pname = "shimelinux";
  inherit (unwrapped) version meta;

  runScript = lib.getExe unwrapped;

  multiArch = true;

  multiPkgs = pkgs:
  with pkgs; [
    glib
    libappindicator
 ];

  unshareIpc = false;  
  unsharePid = false;

  extraInstallCommands = ''
    mkdir -p $out/share
    ln -sf ${unwrapped}/share/applications $out/share
    ln -sf ${unwrapped}/share/icons $out/share
  '';
}
